{
  "name": "learnward-ui-v8",
  "version": "0.8.0",
  "private": true,
  "description": "Prototype UI LearnWard v8 : la v7 corrigée, fiabilisée et allégée (pages statiques, contenu chargé à la demande). Données fictives, sans backend.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run gen:catalog",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "gen:catalog": "tsx scripts/gen-catalog.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.2.8",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "lucide-react": "0.542.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
